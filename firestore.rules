rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permite lectura y escritura de usuarios, misiones dinámicas y snapshots del juego
    match /users/{userId} {
      allow read, write: if true;
    }
    match /custom_missions/{missionId} {
      allow read, write: if true;
    }
    match /snapshots/{snapshotId} {
      allow read, write: if true;
    }
    match /settings/{settingId} {
      allow read, write: if true;
    }
  }
}
